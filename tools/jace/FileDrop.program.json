{"name":"FileDrop","className":"Prog_8827220d5ec9ccbf80e773a8","classFile":"","source":"  /*\n   * Geçici kurulum yardımcısı: istasyonun dosya alanına (file:^…) dosya yazar.\n   * path = \"^px/Mantar/RoomAuto.px\", data = içerik (base64); execute → result = \"OK …\" / \"ERR …\".\n   * Kurulum sayfası işi bitince bu programı siler (istasyonda dosya yazan bir şey kalmaz).\n   */\n\n  public void onExecute() throws Exception {\n    String p = getString(\"path\");\n    if (p.length() == 0) { setString(\"result\", \"ERR boş path\"); return; }\n    try {\n      FilePath fp = new FilePath(p);\n      // remove = true: dosya silinir (kaldırılan sayfalar için)\n      if (getBoolean(\"remove\")) {\n        if (BFileSystem.INSTANCE.findFile(fp) != null) BFileSystem.INSTANCE.delete(fp, null);\n        setString(\"result\", \"OK \" + p + \" удалён\");\n        return;\n      }\n      ensureDir(fp.getParent());\n      BIFile f = BFileSystem.INSTANCE.findFile(fp);\n      if (f == null) f = BFileSystem.INSTANCE.makeFile(fp, null);\n      byte[] data = java.util.Base64.getDecoder().decode(getString(\"data\"));\n      f.write(data);\n      setString(\"result\", \"OK \" + p + \" \" + data.length);\n    } catch (Exception e) {\n      setString(\"result\", \"ERR \" + p + \" \" + e);\n    }\n  }\n\n  void ensureDir(FilePath dir) throws Exception {\n    if (dir == null || BFileSystem.INSTANCE.findFile(dir) != null) return;\n    ensureDir(dir.getParent());\n    BFileSystem.INSTANCE.makeDir(dir, null);\n  }\n","checksum":4923333,"dependencies":"baja;program-rt","userDefinedImports":"baja:javax.baja.file","props":[{"name":"path","type":"baja:String","value":""},{"name":"data","type":"baja:String","value":""},{"name":"remove","type":"baja:Boolean","value":"false"},{"name":"result","type":"baja:String","value":""}],"actions":[],"builtAt":"2026-09-25T19:16:46.813Z"}